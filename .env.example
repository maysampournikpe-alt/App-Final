# Copy to .env.local for local work. Never commit real values.
# In production these live in Vercel: Project > Settings > Environment Variables.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # publishable / anon key. Safe for the browser.
SUPABASE_SERVICE_ROLE_KEY=            # SECRET. Server only. Mark Sensitive in Vercel.

# Groq (console.groq.com/keys). Server only. Needed for the Opportunity Finder's web search, and as a backup for everything else.
GROQ_API_KEY=

# Claude through Cloudflare (optional, server only). When both are set, the Coach, notes, quizzes and the question checker use Claude.
# Web search still uses Groq. Set AI_PROVIDER=groq to switch Claude off. CLAUDE_MODEL defaults to anthropic/claude-sonnet-5.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AI_PROVIDER=
CLAUDE_MODEL=

# Protects the question-bank admin route and cron endpoints.
ADMIN_TOKEN=
CRON_SECRET=
