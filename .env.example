# Copy to .env.local for local work. Never commit real values.
# In production these live in Vercel: Project > Settings > Environment Variables.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # publishable / anon key. Safe for the browser.
SUPABASE_SERVICE_ROLE_KEY=            # SECRET. Server only. Mark Sensitive in Vercel.

# Groq (console.groq.com/keys). Server only.
GROQ_API_KEY=

# Protects the question-bank admin route and cron endpoints.
ADMIN_TOKEN=
CRON_SECRET=
